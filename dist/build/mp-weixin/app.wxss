page{background-color:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif;font-size:28rpx;color:#333}.container{padding:24rpx}.card{background:#fff;border-radius:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);padding:24rpx;margin-bottom:24rpx}.btn{display:flex;align-items:center;justify-content:center;height:88rpx;border-radius:16rpx;font-size:32rpx;font-weight:500;transition:all .2s ease}.btn-primary{background:#4db6ac;color:#fff}.btn-primary:active{background:#00897b}.btn-secondary{background:#fff;color:#333;border:2rpx solid #EEEEEE}.btn-secondary:active{background:#f5f5f5}.btn-disabled{opacity:.5;pointer-events:none}.form-item{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #E0E0E0}.form-item:last-child{border-bottom:none}.form-item .label{width:200rpx;font-size:28rpx;color:#666;flex-shrink:0}.form-item .value{flex:1;font-size:28rpx;color:#333;text-align:right}.input{flex:1;height:80rpx;padding:0 16rpx;font-size:28rpx;background:#fff;border:2rpx solid #EEEEEE;border-radius:8rpx}.input:focus{border-color:#4db6ac}.text-center{text-align:center}.text-primary{color:#4db6ac}.text-secondary{color:#666}.text-hint{color:#999}.flex{display:flex}.flex-col{flex-direction:column}.items-center{align-items:center}.justify-center{justify-content:center}.justify-between{justify-content:space-between}.flex-1{flex:1}.gap-sm{gap:16rpx}.gap-md{gap:24rpx}.mt-sm{margin-top:16rpx}.mt-md{margin-top:24rpx}.mb-md{margin-bottom:24rpx}.ml-md{margin-left:24rpx}.mr-md{margin-right:24rpx}
page::after{position:fixed;content:'';left:-1000px;top:-1000px;-webkit-animation:shadow-preload .1s;-webkit-animation-delay:3s;animation:shadow-preload .1s;animation-delay:3s}@-webkit-keyframes shadow-preload{0%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}100%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}}@keyframes shadow-preload{0%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}100%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}}page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}