<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal" >

    <EditText
        android:id="@+id/edit_multi_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/multi_hint"
        android:singleLine="true" >
    </EditText>

    <Button
        android:id="@+id/btn_multi_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="@+id/edit_multi_text"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="@+id/edit_multi_text"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:text="@string/multi_btn" />

</RelativeLayout>