<template>
  <view class="checkbox-group" @click="handleClick">
    <view
      v-for="(option, index) in options"
      :key="option.value"
      class="checkbox-item"
      @click.stop="toggleOption(option)"
    >
      <view class="checkbox-box" :class="{ active: checkedValues.includes(option.value) }">
        <view v-if="checkedValues.includes(option.value)" class="checkbox-check">
          ✓
        </view>
      </view>
      <text class="checkbox-label">{{ option.label }}</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, watch } from 'vue'

interface CheckboxOption {
  value: string
  label: string
}

const props = withDefaults(defineProps<{
  modelValue: string[]
  options: CheckboxOption[]
  title?: string
}>(), {
  title: ''
})

const emit = defineEmits<{
  (e: 'update:modelValue', value: string[]): void
}>()

const checkedValues = ref([...props.modelValue])

watch(() => props.modelValue, (newVal) => {
  checkedValues.value = [...newVal]
}, { deep: true })

const toggleOption = (option: CheckboxOption) => {
  const index = checkedValues.value.indexOf(option.value)
  if (index > -1) {
    checkedValues.value.splice(index, 1)
  } else {
    checkedValues.value.push(option.value)
  }
  emit('update:modelValue', [...checkedValues.value])
}

const handleClick = () => {
  // 点击整个区域
}
</script>

