const patientName = computed(() => store.currentPatient?.PATIENTNAME || '患者详情')

// 下拉选项配置
const purificationModeOptions = [
  { value: 'HD', label: 'HD' },
  { value: 'HDF', label: 'HDF' },
  { value: 'CRRT', label: 'CRRT' },
  { value: 'SLED', label: 'SLED' }
]

const vascularAccessOptions = [
  { value: '1', label: '动静脉内瘘' },
  { value: '2', label: '中心静脉导管' },
  { value: '3', label: '人造血管' }
]

const purifierTypeOptions = [
  { value: '1', label: '类型A' },
  { value: '2', label: '类型B' },
  { value: '3', label: '类型C' }
]

const dialyzerOptions = [
  { value: '1', label: '型号X' },
  { value: '2', label: '型号Y' },
  { value: '3', label: '型号Z' }
]

const dialyzerMembraneOptions = [
  { value: '1', label: '聚砜膜' },
  { value: '2', label: '聚丙烯腈膜' },
  { value: '3', label: '其他' }
]

const unitOptions = [
  { value: 'mg', label: 'mg' },
  { value: 'ug', label: 'ug' },
  { value: 'ml', label: 'ml' }
]

const doctorOptions = [
  { value: '1', label: '张医生' },
  { value: '2', label: '李医生' },
  { value: '3', label: '王医生' },
  { value: '4', label: '赵医生' }
]

const nurseOptions = [
  { value: '1', label: '护士A' },
  { value: '2', label: '护士B' },
  { value: '3', label: '护士C' },
  { value: '4', label: '护士D' }
]

const yesNoOptions = [
  { value: '1', label: '是' },
  { value: '0', label: '否' }
]

const hasNotOptions = [
  { value: '1', label: '有' },
  { value: '0', label: '无' }
]

const goodPoorOptions = [
  { value: '1', label: '良好' },
  { value: '0', label: '欠佳' }
]

// 治疗信息表单
const cureInfoForm = reactive<Partial<MedCureInfo>>({
  purification_Mode: '',
  frequency_Hours: '',
  frequency_Minute: '',
  clean_Up_Times: '',
  vascular_Access_Id: '',
  machine_Type: '',
  machine_Id: '',
  purifier_Name: '',
  purifier_M2: '',
  heparin_Species: '',
  first_Heparin: '',
  first_Drug_Unit: 'mg',
  dosis_Sustentativa: '',
  second_Drug_Unit: 'mg',
  use_Type: '',
  reuse_Times: '',
  primary_Doctor: '',
  primary_Nurse: '',
  puncture_Nurse: '',
  before_Dry_Weight: '',
  after_Dry_Weight: '',
  last_Time_Dry_Weight: '',
  filtration_Displacement_Liquid: '',
  filtration_Percolate: '',
  displacement_Liquid: '',
  percolate: ''
})

const handleRefresh = () => {
  store.fetchPatients()
}

const formatStatus = (status: string | number) => {
  const statusMap: Record<string | number, string> = {
    '1': '透析中',
    '2': '已结束',
    '3': '待治疗'
  }
  return statusMap[status] || '未知'
}

const getStatusClass = (status: string | number) => {
  const classMap: Record<string | number, string> = {
    '1': 'status-dialyzing',
    '2': 'status-finished',
    '3': 'status-waiting'
  }
  return classMap[status] || ''
}

const handleSave = () => {
  uni.showToast({
    title: '保存成功',
    icon: 'success'
  })
}

const handleSaveAssessment = () => {
  uni.showToast({
    title: '评估信息保存成功',
    icon: 'success'
  })
}

const handleNavigateOrders = () => {
  uni.navigateTo({
    url: '/pages/orders/index'
  })
}

const handleNavigateParams = () => {
  uni.navigateTo({
    url: '/pages/dialysis-param/index'
  })
}

const handleNavigateSummary = () => {
  uni.navigateTo({
    url: '/pages/summary/index'
  })
}

onMounted(() => {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = currentPage.options as any
  
  if (options.id) {
    scheduleId.value = options.id
    // 加载治疗信息
  }
  
  // 初始化数据
  if (store.currentPatient) {
    const order = store.orders.find(o => o.PATIENT_SCHEDULE_ID === store.currentPatient.PATIENT_SCHEDULE_ID)
    if (order) {
      Object.assign(cureInfoForm, {
        PEND_ID: order.PEND_ID,
        PATIENT_SCHEDULE_ID: order.PATIENT_SCHEDULE_ID,
        PURIFICATION_MODE: store.currentPatient.PURIFICATION_MODE,
        MOEDL_NAME: store.currentPatient.MODEL_NAME,
        BEDNAME: store.currentPatient.BEDNAME
      })
    }
  }
})
</script>

